# Supabase browser configuration (public publishable/anon key; never use service_role here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional image analysis. API keys stay server-side (no VITE_ prefix).
# Gemini is the default provider; request a key from Google AI Studio.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# To use another OpenAI-compatible provider instead:
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your-provider-key
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-provider-vision-model
